{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "launch",
            "type": "debugpy",
            "request": "launch",
            "module": "launch",
            "console": "internalConsole",
            "justMyCode": false,
            "env": {
                "PYTHONPATH": "${workspaceFolder}/components"
            }
        },
        {
            "name": "file",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "internalConsole",
            "justMyCode": false,
            "env": {
                "PYTHONPATH": "${workspaceFolder}/components"
            }
        },
        {
            "name": "terminal:launch",
            "type": "debugpy",
            "request": "launch",
            "module": "launch",
            "console": "integratedTerminal",
            "justMyCode": false,
            "env": {
                "PYTHONPATH": "${workspaceFolder}/components"
            }
        },
        {
            "name": "terminal:file",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "justMyCode": false,
            "env": {
                "PYTHONPATH": "${workspaceFolder}/components"
            }
        }
    ]
}